exports[`4-panel app grid markup matches snapshot (from the real index.html) 1`] = `
"<main class="app-grid">
      <section class="panel panel--left" aria-label="Measurements">
        <h2 data-i18n="nav.measurements">Measurements</h2>
        <div id="measurement-form"></div>
        <h2><img src="icons/label.svg" alt="" class="icon"> <span data-i18n="label.title">Label Design</span></h2>
        <div id="label-style-selector"></div>
        <div id="label-shape-selector"></div>
        <div id="material-selector"></div>
      </section>

      <section class="panel panel--center" aria-label="3D Viewer">
        <div class="viewer-heading"><img src="icons/cube-3d.svg" alt="" class="icon"> <span data-i18n="viewer.title">3D Viewer</span></div>
        <div id="threejs-viewer" class="viewer"></div>
      </section>

      <section class="panel panel--right" aria-label="Label Design Options">
        <h2><img src="icons/upload.svg" alt="" class="icon"> <span data-i18n="form.uploadPhoto">Upload Photo</span></h2>
        <div id="photo-uploader"></div>
        <div id="camera-capture"></div>
        <h2><img src="icons/label.svg" alt="" class="icon"> <span data-i18n="label.content.logo">Logo</span></h2>
        <div id="logo-uploader"></div>
        <h2><img src="icons/label.svg" alt="" class="icon"> Label Preview</h2>
        <img id="label-preview" class="label-preview" alt="">
        <div id="pipeline-status" class="pipeline-status"></div>
      </section>

      <section class="panel panel--bottom" aria-label="Export">
        <div id="export-panel"></div>
      </section>
    </main>"
`;

