{
  "name": "packlab3d",
  "version": "0.1.0",
  "description": "PackLab 3D - Precision Packaging Design.",
  "main": "electron/main.js",
  "author": "PackLab 3D",
  "private": true,
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "build": "vite build",
    "build:renderer": "vite build",
    "build:win": "npm run build:renderer && electron-builder --config electron-builder.yml --win",
    "manifest:release": "node scripts/generate-release-manifest.js",
    "verify:release": "node scripts/verify-release.js",
    "smoke:packaged": "node scripts/smoke-packaged.js",
    "measure:startup": "node scripts/measure-startup.js",
    "postinstall": "electron-builder install-app-deps",
    "test": "jest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@playwright/test": "^1.62.1",
    "babel-jest": "^30.4.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "three": "^0.166.1",
    "vite": "^5.4.0"
  }
}
